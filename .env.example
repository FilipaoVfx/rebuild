# Base de datos. En desarrollo local, el stack de scripts/dev_db.sh.
URI_DATABASE_URL=postgresql://uri:uri@127.0.0.1:5433/uri


# Perfil de export por defecto (fuentes.md §5).
URI_EXPORT_PROFILE=INTERNAL

# Credenciales de Copernicus Data Space Ecosystem (scripts/fetch_sentinel.py).
#
# Se crean en dataspace.copernicus.eu -> Dashboard -> User Settings ->
# OAuth clients -> Create. El secreto solo se muestra UNA vez.
#
# Sin prefijo URI_ a proposito: son credenciales de un servicio externo, no
# configuracion de esta aplicacion.
#
# NUNCA en el visor, nunca en un archivo versionado. `.env` esta en
# .gitignore; este `.env.example` no lleva valores reales.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
